# Claude
alias claude-yolo='claude --dangerously-skip-permissions'
alias claude-symlink-otter-laptop='ln -s $HOME/.agents/rules $HOME/Library/Application\ Support/Otter/claude-code-user/rules; ln -s $HOME/.agents/skills $HOME/Library/Application\ Support/Otter/claude-code-user/skills'
alias claude-symlink-otter-devbox='ln -s $HOME/.agents/rules $HOME/.config/otter/claude-code-user/rules; ln -s $HOME/.agents/skills $HOME/.config/otter/claude-code-user/skills'

# CMS Development
function cms_devpod_up() {
    cd ~/work/canva
    infra devpod create --name content-management-rpc --target dev --reason "CMS development" --bazel-target //backend/content_management_rpc:image
}
function cms_query_devpod_up() {
    cd ~/work/canva
    infra devpod create --name content-management-query-rpc --target dev --reason "CMS development" --bazel-target //backend/content_management_query_rpc:image     
}
function cms_web_up() {
    cd ~/work/canva/web
    USER_LOCALE=en-GB pnpm webpack-dev-server -e admin_cms -p iris-dev
}
alias cms-dev-1="cms_devpod_up"
alias cms-dev-2="cms_query_devpod_up"
alias cms-dev-3="cms_web_up"

