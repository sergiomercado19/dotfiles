# ====
# PATH
# ====

export PATH="$HOME/.local/bin:$PATH"

# ======
# OLLAMA
# ======

export WIN_HOST_IP=$(ip route | grep default | awk '{print $3}')

export ANTHROPIC_AUTH_TOKEN="ollama"
export ANTHROPIC_BASE_URL="http://$WIN_HOST_IP:11434"

# Force all internal tasks to use local models
export ANTHROPIC_DEFAULT_HAIKU_MODEL="Qwen3.5-4B"
export ANTHROPIC_DEFAULT_SONNET_MODEL="Qwen2.5-Coder-7B"
export ANTHROPIC_DEFAULT_OPUS_MODEL="Qwen3-8B"

